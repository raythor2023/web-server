---
import { getCollection } from 'astro:content';
import PrivacyPolicyPage from '../../../../components/PrivacyPolicyPage.astro';
import { LOCALES } from '../../../../config/site';

export async function getStaticPaths() {
  const policies = await getCollection('privacy');

  return LOCALES.filter(({ route }) => route).map((locale) => {
    const entry = policies.find(
      ({ data }) => data.appId === 'pongtrace' && data.locale === locale.code,
    );

    if (!entry) {
      throw new Error(`Missing PongTrace privacy policy for ${locale.code}`);
    }

    return {
      params: { locale: locale.route },
      props: {
        policy: entry.data,
        availableLocales: policies
          .filter(({ data }) => data.appId === 'pongtrace')
          .map(({ data }) => data.locale),
      },
    };
  });
}

const { policy, availableLocales } = Astro.props;
---

<PrivacyPolicyPage policy={policy} availableLocales={availableLocales} />
