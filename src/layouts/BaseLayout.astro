---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: string;
  skipLabel: string;
  alternateLocales?: Array<{ lang: string; href: string }>;
  canonicalPath?: string;
  xDefaultPath?: string;
}

const {
  title,
  description,
  lang,
  skipLabel,
  alternateLocales = [],
  canonicalPath = Astro.url.pathname,
  xDefaultPath,
} = Astro.props;
const canonicalURL = new URL(canonicalPath, Astro.site);
const socialImage = new URL(`${import.meta.env.BASE_URL}images/pongtrace/social-card.png`, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090e16" />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonicalURL} />
    {
      alternateLocales.map((alternate) => (
        <link rel="alternate" hreflang={alternate.lang} href={new URL(alternate.href, Astro.site)} />
      ))
    }
    {
      xDefaultPath && (
        <link rel="alternate" hreflang="x-default" href={new URL(xDefaultPath, Astro.site)} />
      )
    }
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}images/pongtrace/app-icon-192.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PongTrace" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{skipLabel}</a>
    <slot />
  </body>
</html>
