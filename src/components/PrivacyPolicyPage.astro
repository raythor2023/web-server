---
import type { CollectionEntry } from 'astro:content';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { LOCALES, privacyPath, productLinkLabels, supportPath } from '../config/site';

type PolicyData = CollectionEntry<'privacy'>['data'];

interface Props {
  policy: PolicyData;
  availableLocales: string[];
}

const { policy, availableLocales } = Astro.props;
const iconLarge = `${import.meta.env.BASE_URL}images/pongtrace/app-icon-512.png`;
const pageDescription = policy.summary;
const alternateLocales = LOCALES.filter((locale) => availableLocales.includes(locale.code)).map(
  (locale) => ({ lang: locale.htmlLang, href: privacyPath(locale.code) }),
);
const linkLabels = productLinkLabels(policy.locale);
---

<BaseLayout
  title={`${policy.pageTitle} · PongTrace`}
  description={pageDescription}
  lang={policy.htmlLang}
  skipLabel={policy.ui.skipToContent}
  alternateLocales={alternateLocales}
  xDefaultPath={privacyPath('zh-Hans')}
>
  <div class="reading-progress" data-reading-progress aria-hidden="true"></div>
  <SiteHeader
    currentLocale={policy.locale}
    availableLocales={availableLocales}
    officialLabel={policy.eyebrow}
    homeLabel={policy.ui.homepage}
    languageMenuLabel={policy.ui.languageMenu}
    availableLanguagesLabel={policy.ui.availableLanguages}
    homeHref={privacyPath(policy.locale)}
    section="privacy"
    appId={policy.appId}
  />

  <main id="main-content" class="legal-page">
    <section class="legal-intro" aria-labelledby="policy-title">
      <div class="legal-intro__inner">
        <div class="legal-intro__identity">
          <img src={iconLarge} alt="" width="64" height="64" />
          <div>
            <span>PongTrace</span>
            <span>{policy.eyebrow}</span>
          </div>
        </div>

        <h1 id="policy-title">{policy.pageTitle}</h1>
        <p class="legal-intro__summary">{policy.summary}</p>

        <div class="legal-intro__meta" aria-label={policy.ui.policyMetadata}>
          <span>{policy.effectiveDate}</span>
          <span aria-hidden="true">·</span>
          <span>{policy.version}</span>
        </div>

        <div class="privacy-facts" aria-label={policy.ui.privacyHighlights}>
        {
          policy.highlights.map((highlight) => (
            <div class="privacy-fact">
              <span>{highlight.label}</span>
              <strong>{highlight.value}</strong>
            </div>
          ))
        }
        </div>
      </div>
    </section>

    <div class="policy-shell">
      <div class="policy-grid">
        <aside class="policy-toc" aria-label={policy.contentsLabel}>
          <span class="policy-toc__label">{policy.contentsLabel}</span>
          <nav>
            {
              policy.sections.map((section, index) => (
                <a href={`#${section.id}`}>
                  <span class="policy-toc__number">{String(index + 1).padStart(2, '0')}</span>
                  <span>{section.title}</span>
                </a>
              ))
            }
            <a href="#website-hosting">
              <span class="policy-toc__number">{String(policy.sections.length + 1).padStart(2, '0')}</span>
              <span>{policy.websiteHosting.title}</span>
            </a>
          </nav>
        </aside>

        <article class="policy-document">
          {
            policy.sections.map((section, index) => (
              <section class="policy-section" id={section.id}>
                <div class="policy-section__heading">
                  <span class="policy-section__number">{String(index + 1).padStart(2, '0')}</span>
                  <h2>{section.title}</h2>
                </div>
                <p>{section.body}</p>
              </section>
            ))
          }

          <section class="policy-section policy-section--supplement" id="website-hosting">
            <div class="policy-section__heading">
              <span class="policy-section__number">{String(policy.sections.length + 1).padStart(2, '0')}</span>
              <h2>{policy.websiteHosting.title}</h2>
            </div>
            <p>{policy.websiteHosting.body}</p>
          </section>
        </article>
      </div>
    </div>
  </main>

  <SiteFooter
    note={policy.footerNote}
    htmlLang={policy.htmlLang}
    links={[{ href: supportPath(policy.locale), label: linkLabels.support }]}
  />

  <button class="back-to-top" type="button" aria-label={policy.ui.backToTop} data-back-to-top>↑</button>

  <script>
    const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
    const backToTop = document.querySelector<HTMLButtonElement>('[data-back-to-top]');

    const updateScrollUI = () => {
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = scrollable > 0 ? Math.min(window.scrollY / scrollable, 1) : 0;
      progress?.style.setProperty('transform', `scaleX(${ratio})`);
      backToTop?.setAttribute('data-visible', String(window.scrollY > 620));
    };

    updateScrollUI();
    window.addEventListener('scroll', updateScrollUI, { passive: true });
    backToTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  </script>
</BaseLayout>
